# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: HTTP port for the Express server. Defaults to 3000 when unset.
PORT=3000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OAUTH_CLIENT_ID: Required for Workspace Integration
VITE_OAUTH_CLIENT_ID="YOUR_OAUTH_CLIENT_ID"

# --- Optional ---

# CORS_ORIGINS: Comma-separated extra origins allowed to call the API.
# APP_URL is used as the primary allowed origin.
CORS_ORIGINS=""

# TRUST_PROXY_HOPS: Number of proxy hops in front of the server (default 1).
TRUST_PROXY_HOPS=1

# JARVIS_PERSONA: "jarvis" (default) or "aarsu".
JARVIS_PERSONA=jarvis

# Google Workspace connect (server-side OAuth, authorisation-code flow).
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
OAUTH_REDIRECT_URI=""

# Home Assistant: set both to control real devices instead of the simulated facility.
HOME_ASSISTANT_URL=""
HOME_ASSISTANT_TOKEN=""

